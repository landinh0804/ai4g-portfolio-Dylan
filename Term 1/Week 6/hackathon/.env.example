# Copy to .env (git-ignored) for local runs. In GitHub Actions these come from
# repository secrets with the same names.
#
# Use an APP PASSWORD, not your real password:
# Bluesky -> Settings -> Privacy and security -> App passwords -> Add.
# It can be revoked at any time without touching the main account.
BSKY_HANDLE=yourname.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
